PROJECT_NAME           = "Quadcopter STM32 Flight Controller"
PROJECT_BRIEF          = "Enterprise embedded flight-control foundations"
OUTPUT_DIRECTORY       = build/doxygen
CREATE_SUBDIRS         = NO
OUTPUT_LANGUAGE        = English

INPUT                  = README.md \
                         Shared \
                         Master_MCU/App \
                         Master_MCU/BSP \
                         docs
FILE_PATTERNS          = *.c *.h *.md
RECURSIVE              = YES
EXCLUDE_PATTERNS       = */build/* */Objects/* */Listings/*

USE_MDFILE_AS_MAINPAGE = README.md
MARKDOWN_SUPPORT       = YES
AUTOLINK_SUPPORT       = YES
EXTRACT_ALL            = YES
EXTRACT_STATIC         = NO
JAVADOC_AUTOBRIEF      = YES
OPTIMIZE_OUTPUT_FOR_C  = YES
TYPEDEF_HIDES_STRUCT   = NO

GENERATE_HTML          = YES
GENERATE_LATEX         = NO
GENERATE_XML           = NO
HTML_OUTPUT            = html
FULL_SIDEBAR           = YES

QUIET                  = YES
WARNINGS               = YES
WARN_IF_UNDOCUMENTED   = NO
WARN_IF_DOC_ERROR      = YES
WARN_NO_PARAMDOC       = NO
WARN_AS_ERROR          = YES
WARN_LOGFILE           = build/doxygen-warnings.log

HAVE_DOT               = NO
CALL_GRAPH             = NO
CALLER_GRAPH           = NO
SOURCE_BROWSER         = YES
INLINE_SOURCES         = NO
